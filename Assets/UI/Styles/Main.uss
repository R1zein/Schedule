/* Единая таблица стилей приложения. Подключена к main.uxml,
   поэтому распространяется и на динамически добавленные шаблоны. */

:root {
    --bg: rgb(28, 30, 38);
    --surface: rgb(40, 43, 54);
    --surface-hover: rgb(52, 56, 70);
    --border: rgb(58, 62, 78);
    --text: rgb(238, 240, 246);
    --text-dim: rgb(150, 156, 172);
    --accent: rgb(232, 168, 84);
    --accent-dim: rgb(196, 128, 96);
    --day-off: rgb(232, 104, 104);

    /* Шрифт проекта. Раскомментировать после проверки, что TMP-ассет
       подхватывается UI Toolkit (Unity 6 умеет это через -unity-font-definition):
    -unity-font-definition: url("project://database/Assets/Folder/Comfortaa-Regular%20SDF.asset");
    */
}

.app-root {
    flex-grow: 1;
    background-color: var(--bg);
    padding: 16px;
}

/* ---------- панели ---------- */

.panel--header {
    flex-shrink: 0;
}

.panel--calendar {
    flex-grow: 1;
}

.panel--overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.panel--hidden {
    display: none;
}

/* ---------- шапка ---------- */

.header {
    flex-direction: row;
    align-items: center;
    padding-bottom: 14px;
}

.header__title {
    flex-grow: 1;
    font-size: 26px;
    color: var(--text);
    -unity-text-align: middle-center;
}

.header__nav {
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    font-size: 26px;
    color: var(--text);
    background-color: var(--surface);
    border-width: 0;
    border-radius: 22px;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.header__nav:hover {
    background-color: var(--surface-hover);
}

.header__nav:active {
    background-color: var(--accent);
}

/* ---------- календарь ---------- */

.calendar {
    flex-grow: 1;
}

.calendar__weekdays {
    flex-direction: row;
    flex-shrink: 0;
}

.weekday {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 13px;
    color: var(--text-dim);
    padding-bottom: 6px;
    -unity-text-align: middle-center;
}

.weekday--weekend {
    color: var(--day-off);
}

.calendar__grid {
    flex-grow: 1;
}

/* TemplateContainer недели */
.week-row-container {
    flex-grow: 1;
    flex-basis: 0;
}

.week-row {
    flex-grow: 1;
    flex-direction: row;
}

/* ---------- ячейка дня (динамический шаблон) ---------- */

/* TemplateContainer ячейки */
.slot-cell {
    flex-grow: 1;
    flex-basis: 0;
}

.slot {
    flex-grow: 1;
    margin: 3px;
    border-width: 1px;
    border-color: var(--border);
    border-radius: 12px;
    background-color: var(--surface);
    overflow: hidden;
}

.slot__surface {
    flex-grow: 1;
    margin: 0;
    padding: 6px;
    align-items: flex-start;
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 12px;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.slot__surface:hover {
    background-color: var(--surface-hover);
}

.slot__day {
    font-size: 17px;
    color: var(--text);
}

.slot--day-off .slot__day {
    color: var(--day-off);
}

/* дни соседних месяцев глушим прозрачностью, чтобы красный выходного не терялся */
.slot--outside {
    opacity: 0.45;
}

.slot--today {
    border-color: var(--accent);
    border-width: 2px;
}

.slot__note-mark {
    display: none;
    position: absolute;
    left: 8px;
    bottom: 8px;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: var(--accent);
}

.slot--has-note .slot__note-mark {
    display: flex;
}

/* выезжающая панель действий */
.slot__popup {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 42%;
    min-width: 34px;
    align-items: center;
    justify-content: center;
    background-color: var(--accent);
    translate: 110% 0;
    transition-property: translate;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.slot--selected .slot__popup {
    translate: 0 0;
}

.slot__action {
    width: 26px;
    height: 26px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Textures/Icons/Notes.png");
    -unity-background-scale-mode: scale-to-fit;
}

.slot__action:hover {
    scale: 1.15 1.15;
}

/* ---------- редактор заметки ---------- */

.note-scrim {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.note-card {
    width: 82%;
    max-width: 520px;
    padding: 16px;
    border-radius: 16px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
}

.note-card__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.note-card__title {
    font-size: 20px;
    color: var(--text);
}

.note-card__close {
    width: 32px;
    height: 32px;
    margin: 0;
    padding: 0;
    font-size: 20px;
    color: var(--text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.note-card__close:hover {
    color: var(--text);
}

.note-card__input {
    min-height: 140px;
    margin-top: 12px;
    margin-left: 0;
    margin-right: 0;
}

.note-card__input .unity-base-text-field__input {
    padding: 10px;
    border-width: 1px;
    border-color: var(--border);
    border-radius: 10px;
    background-color: var(--bg);
    color: var(--text);
    white-space: normal;
}

.note-card__footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

.button--primary {
    margin: 0;
    padding: 8px 18px;
    font-size: 15px;
    color: rgb(28, 30, 38);
    background-color: var(--accent);
    border-width: 0;
    border-radius: 10px;
}

.button--primary:hover {
    background-color: rgb(244, 186, 110);
}
