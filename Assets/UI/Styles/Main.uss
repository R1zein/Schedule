/* Общий лист приложения: подключён во всех uxml, поэтому накрывает и статические
   панели, и добавленные в рантайме шаблоны. Здесь живут токены и то, что либо
   повторяется, либо переключается состоянием — остальное инлайном в самой панели. */

:root {
    --bg: rgb(28, 30, 38);
    --surface: rgb(40, 43, 54);
    --surface-hover: rgb(52, 56, 70);
    --border: rgb(58, 62, 78);
    --text: rgb(238, 240, 246);
    --text-dim: rgb(150, 156, 172);
    --accent: rgb(232, 168, 84);
    --accent-dim: rgb(196, 128, 96);
    --day-off: rgb(232, 104, 104);

    /* Шрифт проекта. Раскомментировать после проверки, что TMP-ассет
       подхватывается UI Toolkit (Unity 6 умеет это через -unity-font-definition):
    -unity-font-definition: url("project://database/Assets/Folder/Comfortaa-Regular%20SDF.asset");
    */
}

.panel--hidden {
    display: none;
}

/* ---------- цвет из токенов ---------- */

/* var() работает только в правиле: в инлайн-стиле UXML резолвера переменных нет,
   он бросает NullReferenceException и вместе с собой роняет сборку всего дерева.
   Поэтому геометрия элемента может уехать инлайном, а цвет из токена — нет. */

.bg-app {
    background-color: var(--bg);
}

.card {
    background-color: var(--surface);
    border-color: var(--border);
}

.tx-bright {
    color: var(--text);
}

/* ---------- кнопки ---------- */

.header__nav {
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    font-size: 26px;
    color: var(--text);
    background-color: var(--surface);
    border-width: 0;
    border-radius: 22px;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.header__nav:hover {
    background-color: var(--surface-hover);
}

.header__nav:active {
    background-color: var(--accent);
}

.button--primary {
    margin: 0;
    padding: 8px 18px;
    font-size: 15px;
    color: rgb(28, 30, 38);
    background-color: var(--accent);
    border-width: 0;
    border-radius: 10px;
}

.button--primary:hover {
    background-color: rgb(244, 186, 110);
}

/* ---------- дни недели ---------- */

.weekday {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 13px;
    color: var(--text-dim);
    padding-bottom: 6px;
    -unity-text-align: middle-center;
}

.weekday--weekend {
    color: var(--day-off);
}

/* ---------- редактор заметки ---------- */

.note-card__close {
    width: 32px;
    height: 32px;
    margin: 0;
    padding: 0;
    font-size: 20px;
    color: var(--text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.note-card__close:hover {
    color: var(--text);
}

/* внутренний элемент TextField — до него дотянуться можно только селектором */
.note-card__input .unity-base-text-field__input {
    padding: 10px;
    border-width: 1px;
    border-color: var(--border);
    border-radius: 10px;
    background-color: var(--bg);
    color: var(--text);
    white-space: normal;
}
