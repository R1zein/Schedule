<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Main.uss" />

    <ui:Template name="HeaderPanel" src="project://database/Assets/UI/Panels/HeaderPanel.uxml" />
    <ui:Template name="CalendarPanel" src="project://database/Assets/UI/Panels/CalendarPanel.uxml" />
    <ui:Template name="NoteEditorPanel" src="project://database/Assets/UI/Panels/NoteEditorPanel.uxml" />

    <!-- main.uxml — контейнер всех панелей. Новая панель = новый Template + Instance здесь. -->
    <ui:VisualElement name="app-root" class="app-root">
        <ui:Instance template="HeaderPanel" name="header-panel" class="panel panel--header" />
        <ui:Instance template="CalendarPanel" name="calendar-panel" class="panel panel--calendar" />
        <ui:Instance template="NoteEditorPanel" name="note-editor-panel" class="panel panel--overlay" />
    </ui:VisualElement>
</ui:UXML>
